# ═══════════════════════════════════════════════════════════════
#  배포 서버에서 쓸 비밀값 템플릿
#  ▶ 서버에서 이 파일을 복사해서 .env 로 만들고 실제 값 채우기:
#       cp .env.example .env  &&  nano .env
#  ▶ .env 는 절대 깃에 올리지 말 것 (.gitignore에 이미 제외돼 있음)
# ═══════════════════════════════════════════════════════════════

# ── MySQL ──────────────────────────────────────────────
DB_ROOT_PASSWORD=여기에_루트비번_아무거나_강하게
DB_NAME=bravodb
DB_USERNAME=bravo
DB_PASSWORD=여기에_DB비번_아무거나_강하게

# ── 앱 비밀값 ──────────────────────────────────────────
# JWT 서명키 (32자 이상, 아무 랜덤 문자열)
JWT_SECRET=여기에_최소32자_랜덤문자열

# 파일 URL 베이스 = 배포 주소 (Elastic IP 나오면 그걸로)
#   예) http://12.34.56.78
FILE_BASE_URL=http://여기에_고정IP

# ── LLM 연동 ───────────────────────────────────────────
# 우리 → LLM (LLM팀이 준 값)
LLM_BASE_URL=http://34.50.39.240:8000
LLM_SERVICE_TOKEN=984270905318f6b6c25138bba3aa305f55d12f020f45f5dd6c62dc1246a4a8a8

# LLM → 우리 (콜백·내부API 검증용). LLM팀과 합의된 실제 값으로.
AGENT_SERVICE_TOKEN=여기에_LLM팀과_합의한_토큰
